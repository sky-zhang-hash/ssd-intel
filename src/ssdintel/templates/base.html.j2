<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{% block title %}SSD 情报日报{% endblock %}</title>
<meta name="theme-color" content="#2457F5">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="SSD 日报">
<link rel="manifest" href="{{ root }}manifest.webmanifest">
<link rel="icon" href="{{ root }}icon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="{{ root }}icon-180.png">
<style>
  /* ---------- tokens：改这一块，四屏一起变 ---------- */
  :root{
    --bg:#F5F7FB;          /* 底色 */
    --card:#FFFFFF;        /* 卡片 */
    --ink:#0F172A;         /* 正文 */
    --muted:#55657D;       /* 次要文字 */
    --line:#E2E8F0;        /* 分隔线 */
    --accent:#2457F5;      /* 主色：链接、主操作 */
    --accent-ink:#FFFFFF;  /* 主色上的字 */
    --accent-2:#0F8F8E;    /* 点缀：圆点、图形 */
    --accent-2-ink:#0A6E6D;/* 点缀色的文字版：同样色相，压深到 4.5:1 以上 */
    --chip:#EEF2F7;        /* 标签底 */
    --radius:8px;
    --shadow:0 1px 3px rgba(15,23,42,.08);
    --font:"PingFang SC","HarmonyOS Sans SC","Microsoft YaHei",system-ui,sans-serif;
    --t-xs:13px; --t-sm:14px; --t-md:17px; --t-lg:24px;
  }
  @media (prefers-color-scheme: dark){
    :root{
      --bg:#0B1220; --card:#131A26; --ink:#E6EAF2; --muted:#93A1B8;
      --line:#22304A; --accent:#6E93FF; --accent-2:#35C6C3;
      --accent-2-ink:#5FD9D6; --chip:#1B2534;
      --shadow:0 1px 3px rgba(0,0,0,.4);
    }
  }
  *{box-sizing:border-box}
  body{
    margin:0; background:var(--bg); color:var(--ink);
    font:400 17px/1.72 var(--font);
    font-variant-numeric:tabular-nums;      /* 数字等宽对齐 */
    -webkit-font-smoothing:antialiased;
    padding:0 14px calc(72px + env(safe-area-inset-bottom,0px));
  }
  .wrap{max-width:680px;margin:0 auto}
  header{padding:22px 4px 14px}
  .kicker{font-size:var(--t-xs);letter-spacing:.04em;color:var(--muted);
          display:flex;justify-content:space-between;align-items:center;gap:10px}
  .badge{font-size:var(--t-xs);padding:3px 9px;border-radius:6px;background:var(--chip);
         color:var(--muted);letter-spacing:0;flex:none}
  h1{font-size:var(--t-lg);line-height:1.42;margin:10px 0 0;font-weight:600;letter-spacing:-.01em}
  /* 每个板块一张白卡：信息密，但边界清楚 */
  section{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);
          box-shadow:var(--shadow);padding:15px 15px 5px;margin:14px 0}
  h2{font-size:16px;line-height:1.4;color:var(--accent-2-ink);margin:2px 0 2px;font-weight:600;
     display:flex;align-items:center;gap:7px}
  h2::before{content:"";width:6px;height:6px;border-radius:50%;background:var(--accent-2);flex:none}
  h2 .cnt{font-size:var(--t-xs);font-weight:400;color:var(--muted);margin-left:2px}
  .point{padding:13px 0;border-bottom:1px solid var(--line)}
  .point:last-child{border-bottom:none}
  .pt-text{margin:0;font-size:var(--t-md);line-height:1.78}
  .impact{margin:9px 0 0;font-size:16px;line-height:1.7;color:var(--muted);
          padding-left:11px;border-left:3px solid var(--accent-2)}
  .meta{margin:10px 0 0;font-size:var(--t-sm);color:var(--muted);display:flex;flex-wrap:wrap;
        gap:8px;align-items:center}
  /* 来源 + 发布时间 + ↗ 合成一个链接：读者点它到原网页。
     宽度占满一行，标签和 ☆ 落到第二行，避免在窄屏上挤成一团。 */
  .meta .src,.meta .nosrc{flex-basis:100%}
  .meta .src{color:var(--accent);text-decoration:none;border:0;
             display:flex;align-items:baseline;gap:6px;
             padding:9px 0 8px;min-height:34px}
  /* 下划线只画在文字下面，不要横贯整行（那样看着像分隔线） */
  .meta .src .lbl{display:inline-flex;align-items:baseline;gap:6px;
                  border-bottom:1px solid var(--accent)}
  .meta .src .when{color:var(--muted)}
  .meta .src .ext{font-size:var(--t-xs);line-height:1}
  .meta .src:active{opacity:.55}
  .meta .nosrc{display:inline-block;padding:7px 0 5px}
  .meta .fav{margin-left:auto}
  .tag{font-size:var(--t-xs);padding:2px 8px;border-radius:6px;background:var(--chip);
       color:var(--muted);white-space:nowrap}
  /* 「全部」页：纯清单，标题本身就是原文链接 */
  /* 安装说明页 */
  .steps{margin:8px 0 10px;padding-left:22px}
  .steps li{margin:6px 0;line-height:1.7}
  .steps li b{font-weight:600}
  ul.steps{list-style:disc}
  .note{color:var(--muted);font-size:14px;line-height:1.7;margin:10px 0 0}
  .qrbox{text-align:center}
  .qr{display:block;margin:12px auto 8px;border-radius:8px;background:#fff;
      width:200px;height:200px}
  .qrurl{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
         font-size:13px;color:var(--accent);word-break:break-all;margin:0}
  .footlink{margin:18px 0 0;font-size:14px}
  .footlink a{color:var(--accent);text-decoration:none;
              display:inline-block;padding:8px 0;border-bottom:1px solid var(--accent)}
  .pt-text a.title{color:var(--ink);text-decoration:none;display:inline-block;padding:4px 0}
  .pt-text a.title:active{opacity:.6}
  .note p{font-size:var(--t-sm);color:var(--muted);line-height:1.7;margin:0 0 6px}
  .watch{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);
         box-shadow:var(--shadow);padding:15px 16px;margin-top:14px}
  .watch h3{margin:0 0 8px;font-size:16px;color:var(--accent-2-ink);font-weight:600;
            display:flex;align-items:center;gap:7px}
  .watch h3::before{content:"";width:6px;height:6px;border-radius:50%;background:var(--accent-2)}
  .watch li{font-size:16px;line-height:1.72;margin:7px 0}
  .watch ul{margin:0;padding-left:18px}
  .price{margin-top:14px;font-size:var(--t-sm);line-height:1.7;color:var(--muted);
         padding:13px 15px;background:var(--card);border-radius:var(--radius);
         border:1px solid var(--line);box-shadow:var(--shadow)}
  footer{margin-top:26px;padding:14px 4px 0;border-top:1px solid var(--line);
         font-size:var(--t-xs);color:var(--muted);display:flex;justify-content:space-between;
         flex-wrap:wrap;gap:8px}
  footer a{color:var(--accent)}
  /* 归档 / 收藏两屏的列表行 */
  .row{display:flex;justify-content:space-between;align-items:baseline;gap:14px;
       padding:15px 0;border-bottom:1px solid var(--line);text-decoration:none;color:inherit}
  .row:last-child{border-bottom:none}
  .row .day{font-size:var(--t-xs);color:var(--muted);flex:none}
  .row .head{font-size:16px;line-height:1.55}
  .row:active .head{color:var(--accent)}
{{ nav_css | safe }}
</style>
</head>
<body>
<div class="wrap">
{% block body %}{% endblock %}
</div>
{{ nav | safe }}
{{ fav_js | safe }}
<script>
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      // updateViaCache:'none' —— 别让浏览器拿缓存里的 sw.js，否则旧缓存策略会一直压着新版本
      navigator.serviceWorker.register('{{ root }}sw.js', { updateViaCache: 'none' })
        .then(reg => {
          // 从后台切回来时主动查一次更新（PWA 常常挂在后台好几天）
          document.addEventListener('visibilitychange', () => {
            if (document.visibilityState === 'visible') reg.update().catch(() => {});
          });
        })
        .catch(() => {});
      // 新版本接管后自动重载一次：否则用户看到的还是旧缓存那屏
      let swapped = false;
      navigator.serviceWorker.addEventListener('controllerchange', () => {
        if (swapped) return;
        swapped = true;
        location.reload();
      });
    });
  }
</script>
</body>
</html>
