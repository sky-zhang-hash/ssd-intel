<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{% block title %}SSD 情报日报{% endblock %}</title>
<meta name="theme-color" content="#0f766e">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="SSD 日报">
<link rel="manifest" href="{{ root }}manifest.webmanifest">
<link rel="icon" href="{{ root }}icon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="{{ root }}icon-180.png">
<style>
  :root{
    --bg:#fbfbf9; --card:#fff; --fg:#191b1f; --muted:#525a66;
    --line:#e7e4de; --accent:#0f766e; --warn:#b45309; --warn-bg:#fdf6e7;
  }
  @media (prefers-color-scheme: dark){
    :root{ --bg:#111316; --card:#181b1f; --fg:#e8e9ea; --muted:#9098a3;
           --line:#272b31; --accent:#5ec9bd; --warn:#e0a458; --warn-bg:#241d10; }
  }
  *{box-sizing:border-box}
  body{
    margin:0; background:var(--bg); color:var(--fg);
    font:400 16px/1.75 -apple-system,BlinkMacSystemFont,"PingFang SC","Hiragino Sans GB",
         "Microsoft YaHei",system-ui,sans-serif;
    -webkit-font-smoothing:antialiased;
    padding:0 20px 72px;
  }
  .wrap{max-width:680px;margin:0 auto}
  header{padding:28px 0 18px;border-bottom:1px solid var(--line);margin-bottom:8px}
  .kicker{font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);
          display:flex;justify-content:space-between;align-items:center}
  .badge{font-size:12px;padding:2px 8px;border-radius:99px;background:var(--line);color:var(--muted);
         letter-spacing:0;text-transform:none}
  h1{font-size:22px;line-height:1.5;margin:10px 0 0;font-weight:650;letter-spacing:-.01em}
  h2{font-size:13px;letter-spacing:.1em;color:var(--accent);margin:34px 0 12px;font-weight:650}
  .point{padding:14px 0;border-bottom:1px solid var(--line)}
  .point:last-child{border-bottom:none}
  .pt-text{margin:0;font-size:16px}
  .impact{margin:8px 0 0;font-size:14px;color:var(--muted);
          padding-left:11px;border-left:2px solid var(--accent)}
  .meta{margin:10px 0 0;font-size:12px;color:var(--muted);display:flex;flex-wrap:wrap;
        gap:8px;align-items:center}
  /* 来源 + 发布时间 + ↗ 合成一个链接：读者点它到原网页。
     宽度占满一行，标签和 ☆ 落到第二行，避免在窄屏上挤成一团。 */
  .meta .src,.meta .nosrc{flex-basis:100%}
  .meta .src{color:var(--accent);text-decoration:none;border:0;
             display:flex;align-items:baseline;gap:5px;
             padding:8px 0 7px;min-height:32px;font-variant-numeric:tabular-nums}
  /* 下划线只画在文字下面，不要横贯整行（那样看着像分隔线） */
  .meta .src .lbl{display:inline-flex;align-items:baseline;gap:5px;
                  border-bottom:1px solid var(--accent)}
  .meta .src .when{color:var(--muted)}
  .meta .src .ext{font-size:12px;line-height:1}
  .meta .src:active{opacity:.55}
  .meta .nosrc{display:inline-block;padding:6px 0 4px}
  .meta .fav{margin-left:auto}
  .tag{font-size:12px;padding:1px 7px;border-radius:4px;background:var(--line);color:var(--muted)}
  .watch{background:var(--warn-bg);border-radius:10px;padding:14px 16px;margin-top:34px}
  .watch h3{margin:0 0 8px;font-size:13px;color:var(--warn);letter-spacing:.06em}
  .watch li{font-size:14px;margin:6px 0}
  .watch ul{margin:0;padding-left:18px}
  .price{margin-top:26px;font-size:13px;color:var(--muted);
         padding:12px 14px;background:var(--card);border-radius:10px;border:1px solid var(--line)}
  footer{margin-top:44px;padding-top:16px;border-top:1px solid var(--line);
         font-size:12px;color:var(--muted);display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px}
  footer a{color:var(--muted)}
  /* 归档 / 收藏两屏的列表行 */
  .row{display:flex;justify-content:space-between;align-items:baseline;gap:14px;
       padding:14px 0;border-bottom:1px solid var(--line);text-decoration:none;color:inherit}
  .row:last-child{border-bottom:none}
  .row .day{font-variant-numeric:tabular-nums;font-size:13px;color:var(--muted);flex:none}
  .row .head{font-size:15px;line-height:1.55}
  .row:active .head{color:var(--accent)}
{{ nav_css | safe }}
</style>
</head>
<body>
<div class="wrap">
{% block body %}{% endblock %}
</div>
{{ nav | safe }}
{{ fav_js | safe }}
<script>
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => navigator.serviceWorker
      .register('{{ root }}sw.js').catch(() => {}));
  }
</script>
</body>
</html>
