{% extends "base.html.j2" %}
{% block title %}SSD 情报日报 · {{ r.date }}{% endblock %}
{% block body %}
  <header>
    <div class="kicker">
      <span>SSD 情报日报 · {{ r.date }}{% if r.window %} · {{ r.window }}{% endif %}</span>
      <span class="badge">{{ 'AI 摘要' if r.mode == 'llm' else '原始清单' }}</span>
    </div>
    <h1>{{ r.headline }}</h1>
    {% if r.lead %}<p class="lead">{{ r.lead }}</p>{% endif %}
  </header>

  {% if r.wx_stats %}
  <p class="wxline">公众号素材 {{ r.wx_stats.total }} 条（带发布时间 {{ r.wx_stats.with_time }} 条）；今天新发 {{ r.wx_stats.today }} 条{% if r.wx_stats.latest %}，最新一条 {{ r.wx_stats.latest }}{% endif %}</p>
  {% endif %}

  {% if r.warn %}
  <div class="warn">{{ r.warn }}</div>
  {% endif %}

  {% if r.flat %}
  {% for p in r.flat %}
    <section class="item"><article class="point">
      <p class="pt-text">{{ p.text }}</p>
      {% if p.impact %}<p class="impact">{{ p.impact }}</p>{% endif %}
      <p class="meta">
        {% if p.url %}
        <a class="src" href="{{ p.url }}" target="_blank" rel="noopener noreferrer"
           title="打开原文"><span class="lbl">{% if p.wx %}<span class="wx">公众号</span>{% endif %}{{ p.source }}{% if p.time %}<span class="when">{{ p.time }}</span>{% endif %}<span class="ext">↗</span></span></a>
        {% else %}
        <span class="nosrc" title="原文链接暂时取不到，稍后会自动补上">{{ p.source }}{% if p.time %} · {{ p.time }}{% endif %}</span>
        {% endif %}
        {% for c in p.cats %}<span class="tag">{{ c }}</span>{% endfor %}
        <button class="fav" data-url="{{ p.url }}" data-title="{{ p.text }}"
                data-source="{{ p.source }}" data-date="{{ r.date }}"
                data-time="{{ p.time }}"
                aria-pressed="false" title="收藏">☆</button>
      </p>
    </article></section>
  {% endfor %}
  {% else %}
    <p class="empty">今天没有抓到达标的条目。可能是源都失败了，或者确实没有产品侧动态。</p>
  {% endif %}

  {% if r.watch %}
  <aside class="watch">
    <h3>值得留意</h3>
    <ul>{% for w in r.watch %}<li>{{ w }}</li>{% endfor %}</ul>
  </aside>
  {% endif %}

  {% if r.price_note %}
  <div class="price">价格背景：{{ r.price_note }}</div>
  {% endif %}

  {% if r.sources %}
  <section class="srcs">
    <h2>数据源（最近更新）</h2>
    <ul class="srclist">
      {% for s in r.sources[:14] %}
      <li><span class="sname">{{ s.source }}</span><span class="sday">{{ s.last[:10] }}</span><span class="scount">{{ s.count }} 条</span></li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  <footer>
    <span>{{ stats.get('items', 0) }} 条素材 / {{ stats.get('sources', 0) }} 个源</span>
    <span>{{ generated }} 生成 · {{ build_ver }}</span>
  </footer>
  <p class="footlink"><a href="{{ root }}install.html">安装到手机，像 App 一样打开 →</a></p>
{% endblock %}
